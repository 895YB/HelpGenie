{
  "name": "@ai-widget/backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "AI Widget Backend — Express + MongoDB + OpenAI RAG",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:unit": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js tests/unit --runInBand --forceExit",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js tests/integration --runInBand --forceExit",
    "test:api": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js tests/api --runInBand --forceExit",
    "test:coverage": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --coverage --runInBand --forceExit",
    "lint": "eslint src --ext .js --fix"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "openai": "^4.52.3",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "eslint": "^9.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js"
    ]
  }
}

# ============================================================
# AI Widget Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Server -----------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ----- MongoDB ----------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai_widget?retryWrites=true&w=majority

# ----- JWT --------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ----- OpenAI -----------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1

# ----- Email (Nodemailer / SMTP) ----------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="AI Widget <noreply@yourapp.com>"

# ----- Uploads ----------------------------------------------
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads

# ----- Rate Limiting ----------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ----- Vector Search ----------------------------------------
VECTOR_SEARCH_INDEX=vector_index
VECTOR_SEARCH_NUM_CANDIDATES=100
VECTOR_SEARCH_LIMIT=5
SIMILARITY_THRESHOLD=0.75

# ----- Frontend Widget Origin (CORS) ------------------------
WIDGET_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
